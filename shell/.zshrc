# Put machine-local overrides in ~/.zshrc.local.

# ---------------------------------------------------------------------------
# Base environment
# ---------------------------------------------------------------------------

# Several tools' configs in this dotfiles repo (fzf, ripgrep, and — on
# macOS specifically — k9s and Go's own env file) only resolve to
# ~/.config/<tool>/... when this is set; macOS doesn't export it by default.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export EDITOR="nvim"
export VISUAL="$EDITOR"

path_append_if_dir() {
  [[ -d "$1" ]] && path+=("$1")
}

path_append_if_dir "$HOME/.local/bin"
path_append_if_dir "$HOME/bin"
path_append_if_dir "$HOME/go/bin"
typeset -U path PATH

if [[ -n "${TERM:-}" ]] && ! infocmp "$TERM" >/dev/null 2>&1; then
  export TERM="xterm-256color"
fi

# ---------------------------------------------------------------------------
# Toolchain activation
# ---------------------------------------------------------------------------

# Activate mise before checking for tools it provides below.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Generated by bootstrap:zsh-completion; Oh My Zsh runs compinit below.
fpath+=("$HOME/.local/share/zsh/site-functions")

# ---------------------------------------------------------------------------
# Oh My Zsh
# ---------------------------------------------------------------------------

export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
ZSH_CUSTOM="${ZSH_CUSTOM:-$ZSH/custom}"
ZSH_THEME="${ZSH_THEME:-}"

zsh_plugin_exists() {
  local plugin="$1"

  [[ -d "$ZSH/plugins/$plugin" || -d "$ZSH_CUSTOM/plugins/$plugin" ]]
}

plugins=()
for plugin in git zsh-autosuggestions you-should-use; do
  zsh_plugin_exists "$plugin" && plugins+=("$plugin")
done

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

# ---------------------------------------------------------------------------
# Prompt, history, navigation, and completion integrations
# ---------------------------------------------------------------------------

# Keep native Zsh history persistent and shared across interactive shells.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=200000
# shellcheck disable=SC2034 # Zsh reads SAVEHIST internally.
SAVEHIST=100000
setopt EXTENDED_HISTORY SHARE_HISTORY HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_VERIFY

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
  alias cd="z"
fi

if command -v fzf >/dev/null 2>&1; then
  # fzf hard-fails (rather than falling back) if this points to a file that
  # doesn't exist yet — e.g. before this repo is symlinked into place.
  [[ -r "$XDG_CONFIG_HOME/fzf/config" ]] && export FZF_DEFAULT_OPTS_FILE="$XDG_CONFIG_HOME/fzf/config"
  # Clear the old exported opt-out, including when inherited by a new shell.
  unset FZF_CTRL_R_COMMAND
  source <(fzf --zsh)
  bindkey '^F' fzf-history-widget
fi

# ---------------------------------------------------------------------------
# Tool configuration, aliases, and helpers
# ---------------------------------------------------------------------------

if command -v eza >/dev/null 2>&1; then
  # LS_COLORS (set elsewhere: a system default, oh-my-zsh, .zshrc.local...)
  # silently overrides eza's own theme.yml for file-kind colors with no
  # warning. Unset it so the Catppuccin theme actually applies.
  unset LS_COLORS
  alias ls="eza"
  alias ll="eza -al --icons=always --git -1"
  alias la="eza -al --icons=always --git"
  alias lt="eza --tree --level=2 --icons=always"
fi

if command -v rg >/dev/null 2>&1; then
  export RIPGREP_CONFIG_PATH="$XDG_CONFIG_HOME/ripgrep/config"
fi

if command -v glow >/dev/null 2>&1; then
  # glow's own config file has no path-expansion for `style` (no `~`, no env
  # vars) — see docs/util_tools.md#glow. Wiring the theme through an alias
  # is the only reliable way to activate it.
  alias glow="glow --style \"\$XDG_CONFIG_HOME/glow/glamour.json\""
fi

# Markdown rendering for CLIs built on Charm's glamour library — gh documents
# this var (`gh help environment`); glab and other glamour tools read the same
# one, so this themes them together rather than being gh-specific. glow itself
# ignores it (see docs/util_tools.md#glow) and is handled by the alias above.
# Gated on the theme file, not on any one tool: a missing path here renders
# unstyled with no error, which would be invisible.
if [[ -r "$XDG_CONFIG_HOME/glow/glamour.json" ]]; then
  export GLAMOUR_STYLE="$XDG_CONFIG_HOME/glow/glamour.json"
fi

if command -v zellij >/dev/null 2>&1; then
  alias za="zellij attach --create"
  alias zs="zellij -l welcome"
fi

if command -v tmux >/dev/null 2>&1; then
  tc() {
    local session="${1:-core}"
    # HOME is expanded by tmux's shell when it launches the plugin.
    # shellcheck disable=SC2016
    local picker='exec "$HOME/.local/share/tmux/plugins/tmux-sessionx/scripts/sessionx.sh"'
    local inside_tmux=false

    if [[ -n "$TMUX" ]] && tmux display-message -p '#S' >/dev/null 2>&1; then
      inside_tmux=true
    fi

    # An explicit name keeps the direct create/attach shortcut.
    if [[ $# -gt 0 ]]; then
      if [[ "$inside_tmux" == true ]]; then
        tmux has-session -t "=$session" 2>/dev/null || tmux new-session -d -s "$session" -c "$HOME" || return
        tmux switch-client -t "=$session"
      else
        TMUX='' TMUX_PANE='' tmux new-session -A -s "$session" -c "$HOME"
      fi
      return
    fi

    if [[ ! -x "$HOME/.local/share/tmux/plugins/tmux-sessionx/scripts/sessionx.sh" ]]; then
      print -u2 'SessionX is missing; run mise run bootstrap:plugins from the dotfiles repository.'
      return 1
    fi

    # Every path uses the complete SessionX plugin and includes all sessions.
    # Set both the public option and SessionX's cached option for live servers.
    if [[ "$inside_tmux" == true ]]; then
      tmux set-option -g @sessionx-filter-current false
      tmux set-option -g @sessionx-_filter-current false
      tmux run-shell -t "$TMUX_PANE" "$picker"
    else
      if ! TMUX='' TMUX_PANE='' tmux has-session 2>/dev/null; then
        # Keep an empty server alive while its config and Continuum restore
        # finish. With a snapshot, use restored sessions instead of adding core.
        TMUX='' TMUX_PANE='' tmux start-server \; set-option -s exit-empty off || return
        TMUX='' TMUX_PANE='' tmux has-session 2>/dev/null ||
          TMUX='' TMUX_PANE='' tmux new-session -d -s core -c "$HOME" || return
        TMUX='' TMUX_PANE='' tmux set-option -s exit-empty on
      fi
      TMUX='' TMUX_PANE='' tmux set-option -g @sessionx-filter-current false
      TMUX='' TMUX_PANE='' tmux set-option -g @sessionx-_filter-current false
      TMUX='' TMUX_PANE='' tmux attach-session \; run-shell "$picker"
    fi
  }
fi

# ---------------------------------------------------------------------------
# Machine-local overrides and final ZLE hook
# ---------------------------------------------------------------------------

if [[ -r "$HOME/.zshrc.local" ]]; then
  source "$HOME/.zshrc.local"
fi

unfunction path_append_if_dir zsh_plugin_exists 2>/dev/null

# This plugin must load after every other ZLE widget and hook.
if [[ -r "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
