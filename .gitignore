# macOS cruft
.DS_Store

# editor swap/backup files
*.swp
*.swo
*~

# mise local overrides — machine-specific, never committed (see AGENTS.md)
mise.local.toml
mise.*.local.toml
.mise.local.toml

# secrets / env files — never committed (see AGENTS.md)
.env
.env.*
!.env.example

# linter caches
.rumdl_cache/

# Tool-written state. A tool whose config directory is symlinked here writes
# *into this repo*, so anything it generates itself must be ignored rather
# than committed. glow auto-creates glow.yml on any run (verified) — it is
# deliberately not managed by this repo, and `mise.toml` symlinks only
# glow/glamour.json for that reason. See docs/util_tools.md#glow.
glow/glow.yml
