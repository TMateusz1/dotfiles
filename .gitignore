# macOS cruft
.DS_Store

# editor swap/backup files
*.swp
*.swo
*~

# mise local overrides — machine-specific, never committed (see AGENTS.md)
mise.local.toml
mise.*.local.toml
.mise.local.toml

# secrets / env files — never committed (see AGENTS.md)
.env
.env.*
!.env.example

# linter caches
.rumdl_cache/

# Zellij owns local backups/state; share only the theme configuration.
/zellij/*
!/zellij/config.kdl

# Zed writes into its symlinked config directory. Track only shareable config;
# settings.json (including SSH connections), databases and generated state stay local.
/zed/*
!/zed/global_settings.json
!/zed/keymap.json
!/zed/tasks.json
!/zed/snippets/
/zed/snippets/*
!/zed/snippets/go.json
